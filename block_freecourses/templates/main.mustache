{{!
    @template block_freecourses/main

    Render the free courses block.
}}

<div id="block-freecourses-{{uniqid}}" class="block_freecourses" data-region="freecourses">
    <div role="search" class="mb-3" aria-label="{{#str}}searchcourses, block_freecourses{{/str}}">
        {{< core/search_input_auto }}
            {{$label}}{{#str}}searchcourses, block_freecourses{{/str}}{{/label}}
            {{$placeholder}}{{#str}}searchcourses, block_freecourses{{/str}}{{/placeholder}}
        {{/ core/search_input_auto }}
    </div>

    {{#hascourses}}
        <div class="row row-cols-1 row-cols-md-2 g-3" data-region="courses-grid">
            {{#courses}}
                <div class="col" data-region="freecourse-card" data-searchtext="{{searchname}}">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title mb-3">{{fullname}}</h3>
                            <a href="{{enrolurl}}" class="btn btn-primary mt-auto">{{#str}}enrolcourse, block_freecourses{{/str}}</a>
                        </div>
                    </div>
                </div>
            {{/courses}}
        </div>

        <div class="alert alert-info mt-3 d-none" data-region="search-empty" role="status">
            {{#str}}nosearchresults, block_freecourses{{/str}}
        </div>
    {{/hascourses}}

    {{^hascourses}}
        <div class="alert alert-info mb-0" role="status">
            {{#str}}nofreecourses, block_freecourses{{/str}}
        </div>
    {{/hascourses}}
</div>

{{#js}}
(function() {
    const root = document.getElementById('block-freecourses-{{uniqid}}');
    if (!root) {
        return;
    }

    const input = root.querySelector('[data-action="search"]');
    const cards = Array.from(root.querySelectorAll('[data-region="freecourse-card"]'));
    const empty = root.querySelector('[data-region="search-empty"]');

    if (!input || !cards.length || !empty) {
        return;
    }

    const normalize = (value) => (value || '').toString().toLowerCase().trim();

    const updateSearch = () => {
        const query = normalize(input.value);
        let visible = 0;

        cards.forEach((card) => {
            const searchtext = normalize(card.getAttribute('data-searchtext'));
            const show = query === '' || searchtext.indexOf(query) !== -1;
            card.classList.toggle('d-none', !show);
            if (show) {
                visible++;
            }
        });

        empty.classList.toggle('d-none', visible !== 0);
    };

    input.addEventListener('input', updateSearch);
})();
{{/js}}
